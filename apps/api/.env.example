PORT=3001
# MySQL (obligatorio). Ejemplo: mysql://user:pass@127.0.0.1:3306/mi_bd
# O: MYSQL_HOST, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE
DATABASE_URL=

# Orígenes del front (coma-separados). Con credenciales no puede ser *; usa lista o deja vacío para reflejar el Origin (desarrollo).
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN=
NODE_ENV=development

# Opcional: desactiva rate limit (solo desarrollo local)
# DISABLE_RATE_LIMIT=true

JWT_SECRET=genera-un-secreto-largo-en-produccion
JWT_EXPIRY=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM_EMAIL=noreply@localhost
SMTP_FROM_NAME=Preventivos CL

WEBSITE_DOMAIN=localhost:3000
# Origen del front (enlaces en correos de recuperación). Opcional si coincide con WEBSITE_DOMAIN.
WEB_APP_URL=http://localhost:3000
# Tras 1 proxy inverso (Cloudflare, nginx), pon 1. Sin proxy (local), no definas.
# TRUST_PROXY_HOPS=1
